# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chatbot_db
DB_USER=chatbot_user
DB_PASSWORD=your_secure_password_here

# API Configuration (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173

# Model Configuration (paths are relative to the project root)
MODEL_PATH=chatbot/data/processed/chatbot_model.pth
INTENTS_PATH=chatbot/data/intents.json
CONFIDENCE_THRESHOLD=0.5

# Embeddings (free local model, downloaded once from Hugging Face)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# RAG (minimum similarity to answer straight from a guide when no LLM is configured)
RAG_MIN_SCORE=0.6

# Training Configuration
HIDDEN_SIZE=64
NUM_EPOCHS=150
BATCH_SIZE=16
LEARNING_RATE=0.003

# LLM Fallback (used when model confidence is low; leave keys empty to disable)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
LLM_TIMEOUT_SECONDS=30
